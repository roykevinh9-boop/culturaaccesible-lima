@startuml
title CulturaAccesible Lima · Modelo relacional implementado
hide circle
skinparam linetype ortho
entity categorias {
* id : BIGINT <<PK>>
--
nombre : VARCHAR(60) UNIQUE
}
entity distritos {
* id : BIGINT <<PK>>
--
nombre : VARCHAR(80) UNIQUE
}
entity recintos {
* id : BIGINT <<PK>>
--
nombre : VARCHAR(160)
distrito_id : BIGINT <<FK>>
direccion : VARCHAR(200)
}
entity eventos {
* id : BIGINT <<PK>>
--
nombre : VARCHAR(180)
descripcion : TEXT
categoria_id : BIGINT <<FK>>
es_demo : INT
fuente_id : VARCHAR(220) UNIQUE NULL
imagen_url : VARCHAR(1200) NULL
imagen_alt : VARCHAR(350) NULL
imagen_credito : VARCHAR(180) NULL
}
entity funciones {
* id : BIGINT <<PK>>
--
evento_id : BIGINT <<FK>>
recinto_id : BIGINT <<FK>>
fecha : DATE
hora : TIME
precio_oficial : DECIMAL(10,2) NULL
url_oficial : VARCHAR(600) NULL
fuente_id : VARCHAR(220) UNIQUE NULL
precio_desde : INT
consultado_en : DATE NULL
}
entity tipos_apoyo {
* id : BIGINT <<PK>>
--
codigo : VARCHAR(40) UNIQUE
nombre : VARCHAR(100)
}
entity evidencias {
* id : BIGINT <<PK>>
--
fuente : VARCHAR(200)
url : VARCHAR(600) NULL
fecha_revision : DATE
valida_hasta : DATE NULL
es_demo : INT
}
entity condiciones {
* id : BIGINT <<PK>>
--
tipo_apoyo_id : BIGINT <<FK>>
alcance : RECINTO / FUNCION
recinto_id : BIGINT NULL <<FK>>
funcion_id : BIGINT NULL <<FK>>
estado : VARCHAR(20)
evidencia_id : BIGINT NULL <<FK>>
observacion : VARCHAR(800)
}
entity reportes {
* id : BIGINT <<PK>>
--
funcion_id : BIGINT <<FK>>
condicion_id : BIGINT NULL <<FK>>
comentario : VARCHAR(1000)
estado : VARCHAR(20)
creado_en : TIMESTAMP
}
eventos ||--o{ funciones
recintos ||--o{ funciones
recintos |o--o{ condiciones
funciones |o--o{ condiciones
tipos_apoyo ||--o{ condiciones
evidencias |o--o{ condiciones
categorias ||--o{ eventos
distritos ||--o{ recintos
funciones ||--o{ reportes
condiciones |o--o{ reportes
note bottom of condiciones
Una condición pertenece a un recinto O a una función.
El CHECK impide referencias simultáneas o vacías.
UNIQUE por tipo de apoyo y alcance concreto.
end note
@enduml
